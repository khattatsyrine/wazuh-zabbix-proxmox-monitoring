<group name="custom,postfix,authentication_failures,">

  <rule id="100101" level="10" frequency="3" timeframe="120">
    <if_matched_sid>3332</if_matched_sid>

    <description>
      Postfix: Multiple SASL authentication failures detected within two minutes.
    </description>

    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
